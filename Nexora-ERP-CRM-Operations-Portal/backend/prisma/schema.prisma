generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SALES
  WAREHOUSE
  ACCOUNTS
}

enum CustomerType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum StockMovementType {
  IN
  OUT
}

enum ChallanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  role           Role     @default(SALES)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customers      Customer[]
  followUps      FollowUp[]
  stockMovements StockMovement[]
  challans       Challan[]

  @@map("users")
  @@index([email])
}

model Customer {
  id           String         @id @default(cuid())
  customerName String
  mobile       String         @unique
  email        String?
  businessName String
  gstNumber    String?
  customerType CustomerType
  address      String
  status       CustomerStatus @default(LEAD)
  followUpDate DateTime?
  notes        String?
  createdBy    String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  createdByUser User         @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  followUps     FollowUp[]
  challans      Challan[]

  @@map("customers")
  @@index([status])
  @@index([customerType])
  @@index([mobile])
}

model FollowUp {
  id           String   @id @default(cuid())
  customerId   String
  note         String
  followUpDate DateTime
  createdBy    String
  createdAt    DateTime @default(now())

  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdByUser User     @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("follow_ups")
  @@index([customerId])
  @@index([followUpDate])
}

model Product {
  id                String           @id @default(cuid())
  productName       String
  sku               String           @unique
  category          String
  unitPrice         Decimal          @db.Decimal(10, 2)
  currentStock      Int              @default(0)
  minimumStock      Int              @default(0)
  warehouseLocation String
  imageUrl          String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  stockMovements StockMovement[]
  challanItems   ChallanItem[]

  @@map("products")
  @@index([sku])
  @@index([category])
}

model StockMovement {
  id        String            @id @default(cuid())
  productId String
  quantity  Int
  type      StockMovementType
  reason    String
  createdBy String
  createdAt DateTime          @default(now())

  product       Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser User    @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("stock_movements")
  @@index([productId])
  @@index([type])
}

model Challan {
  id            String        @id @default(cuid())
  challanNumber String        @unique
  customerId    String
  totalQuantity Int           @default(0)
  status        ChallanStatus @default(DRAFT)
  paymentStatus PaymentStatus @default(UNPAID)
  createdBy     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser User          @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items         ChallanItem[]

  @@map("challans")
  @@index([customerId])
  @@index([status])
  @@index([challanNumber])
}

model ChallanItem {
  id          String  @id @default(cuid())
  challanId   String
  productId   String
  productName String
  sku         String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int

  challan Challan @relation(fields: [challanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("challan_items")
  @@index([challanId])
}